# Copy to .env and adjust. Never commit .env.
# Each build step adds the variables it needs here (storage, email, AI).

# --- API ---
NODE_ENV=development
API_PORT=3000
# Where the desk runs (CORS). In production the desk calls the API through a same-site /api proxy.
DESK_ORIGIN=http://localhost:5173
# Set true on Railway so rate limits see the real client IP.
TRUST_PROXY=false
# Secure cookies need HTTPS; defaults to true in production.
COOKIE_SECURE=false

# --- Database (docker compose) ---
DATABASE_URL=postgres://shubhjets:shubhjets@localhost:5432/shubhjets
DATABASE_SSL=false
# Tests wipe this database; its name must end in _test.
TEST_DATABASE_URL=postgres://shubhjets:shubhjets@localhost:5432/shubhjets_test

# --- Security ---
# At least 32 random characters. Production: generate with `openssl rand -base64 48`.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Encrypts bank details and guest ID files. "<id>:<base64 32 bytes>", newest first, comma-separated for rotation.
# Generate with: pnpm --filter @shubhjets/api gen:key   (the value below is for local development only)
DATA_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMTIzNDU2Nzg=

# --- Owner account ---
# On a fresh database the API creates the owner from these (at least 12 characters; weak passwords are refused).
# Locally you can leave them empty: `pnpm seed` creates a development owner instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Desk ---
VITE_API_URL=http://localhost:3000
