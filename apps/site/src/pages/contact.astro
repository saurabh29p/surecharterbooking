---
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { company, PAYMENT_SAFETY, show } from '../config/company';
import { telLink, whatsappLink } from '../config/site';
import Page from '../layouts/Page.astro';

const a = company.address;
const direct = show.whatsapp || show.phone || show.email;
const title = show.whatsapp
  ? 'Contact Vaanika: WhatsApp, call or enquire'
  : 'Contact Vaanika: plan your wedding flight';
const description = show.whatsapp
  ? `Talk to a Vaanika coordinator on WhatsApp or by phone, or send the enquiry form. We reply ${company.replyTime}.`
  : `Send the enquiry form with your date, cities and guests. A Vaanika coordinator replies ${company.replyTime}.`;
const lead = show.whatsapp
  ? `WhatsApp is fastest: tell us the date, the cities and how many guests are flying, and a coordinator replies ${company.replyTime} with options and one written, all-in price.`
  : `Tell us the date, the cities and how many guests are flying, and a coordinator replies ${company.replyTime} with options and one written, all-in price.`;
---

<Page
  title={title}
  description={description}
  pageName="Contact"
  eyebrow="Contact & quote"
  heading="Talk to a coordinator."
  lead={lead}
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
  planHref="#enquire"
  noCta
>
  <section id="enquire" class="section" aria-label="Enquiry">
    <div class:list={['container ct', { 'ct--form-first': !direct }]}>
      <div class="ct__side">
        {direct && (
          <div class="ct__actions">
            {show.whatsapp && (
              <a
                class="btn btn--gold btn--lg btn--block"
                href={whatsappLink('Contact')}
                data-tap="WHATSAPP"
              >
                <Icon name="chat" size={20} stroke={2} />
                WhatsApp {company.whatsapp.display}
              </a>
            )}
            {show.phone && (
              <a class="btn btn--outline btn--lg btn--block" href={telLink} data-tap="CALL">
                <Icon name="phone" size={20} stroke={2} />
                Call {company.phone.display}
              </a>
            )}
            {show.email && (
              <a class="btn btn--ghost btn--block" href={`mailto:${company.email.hello}`}>
                <Icon name="mail" size={18} />
                {company.email.hello}
              </a>
            )}
          </div>
        )}
        <dl class="ct__facts">
          <dt>Reply time</dt>
          <dd>{company.replyTime}</dd>
          <dt>Office</dt>
          <dd>
            {company.legalName}
            <br />
            {show.address ? `${a.street}, ${a.city} ${a.postalCode}` : a.city}
          </dd>
          <dt>Grievance officer</dt>
          <dd>
            {show.grievanceOfficer && (
              <>
                {company.grievanceOfficer.name}, {company.grievanceOfficer.designation}
                <br />
              </>
            )}
            {show.email && (
              <>
                <a href={`mailto:${company.email.grievance}`}>{company.email.grievance}</a> ·{' '}
              </>
            )}
            <a href="/legal/grievance/">How complaints work</a>
          </dd>
        </dl>
        <p class="note ct__safety">
          <strong>Payment safety.</strong> {PAYMENT_SAFETY}
        </p>
      </div>
      <div class="ct__form">
        <h2 class="ct__title display">Send an enquiry</h2>
        <EnquiryForm id="contact-enquiry" pageName="Contact" variant="full" />
      </div>
    </div>
  </section>
</Page>

<style>
  .ct {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr;
    gap: 56px;
    align-items: start;
  }

  .ct__facts:first-child {
    margin-top: 0;
  }

  .ct__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ct__facts {
    margin-top: 32px;
    display: grid;
    gap: 6px;
    font-size: 15px;
  }

  .ct__facts dt {
    margin-top: 10px;
    color: var(--gold);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ct__facts dd {
    margin: 0;
    color: var(--text-2);
  }

  .ct__safety {
    margin-top: 28px;
  }

  .ct__safety strong {
    color: var(--gold-light);
  }

  .ct__title {
    font-size: 30px;
    margin-bottom: 18px;
  }

  @media (max-width: 899px) {
    .ct {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    /* With no WhatsApp/call yet, the form is the way in: put it first on phones. */
    .ct--form-first .ct__form {
      order: -1;
    }
  }
</style>
