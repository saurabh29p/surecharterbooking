---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../config/site';
import Base from '../layouts/Base.astro';

const destinations = (await getCollection('destinations')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Page not found | Vaanika"
  description="This page doesn’t exist. Message us on WhatsApp or choose a destination."
  pageName="404"
>
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">Page not found</p>
      <h1 class="nf__title display">This page has flown elsewhere.</h1>
      <p class="nf__lead">
        The link may be old or mistyped. Message us and a coordinator will help, or start from a
        destination.
      </p>
      <div class="nf__actions">
        <a class="btn btn--gold btn--lg" href={whatsappLink('404')} data-tap="WHATSAPP">
          <Icon name="chat" size={20} stroke={2} />
          Message us on WhatsApp
        </a>
        <a class="btn btn--outline btn--lg" href="/">
          Go to the home page
        </a>
      </div>
      <h2 class="nf__h2">Destinations</h2>
      <ul class="nf__list">
        {destinations.map((d) => (
          <li>
            <a href={`/destinations/${d.id}/`}>
              {d.data.name}
              <Icon name="arrow" size={16} />
            </a>
          </li>
        ))}
        <li>
          <a href="/destinations/">
            All destinations <Icon name="arrow" size={16} />
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 96px 0 120px;
  }

  .nf__inner {
    max-width: 760px;
  }

  .nf__title {
    margin-top: 16px;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.05;
  }

  .nf__lead {
    margin-top: 20px;
    font-size: 18px;
    color: var(--text-2);
  }

  .nf__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nf__h2 {
    margin-top: 56px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .nf__list {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .nf__list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    color: var(--ivory);
    font-family: var(--font-display), Georgia, serif;
    font-size: 22px;
    text-decoration: none;
  }

  .nf__list a:hover {
    color: var(--gold-light);
  }

  .nf__list :global(svg) {
    color: var(--gold);
  }
</style>
