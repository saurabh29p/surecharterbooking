---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import StickyContact from '../components/StickyContact.astro';
import { ANALYTICS, GOOGLE_ADS_ID, INDEXABLE, PREVIEW, SITE_URL } from '../config/site';

interface Props {
  /** ≤ 60 characters, with the page's main phrase. */
  title: string;
  /** Written as a direct answer (WEBSITE.md §9). */
  description: string;
  /** Short name for messages, e.g. "Udaipur" or "home". */
  pageName: string;
  /** Where "Plan my flight" points: "#enquire" when the page has the form. */
  planHref?: string;
  /** Social sharing image (absolute or root-relative). */
  ogImage?: string;
  /** JSON-LD objects for this page. */
  jsonLd?: object[];
}

const {
  title,
  description,
  pageName,
  planHref = '/contact/#enquire',
  ogImage = '/og/vaanika.jpg',
  jsonLd = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
/** Search snippets stay under ~160 characters: keep the answer-first sentence, or cut at a word. */
function snippet(text: string): string {
  if (text.length <= 160) return text;
  const first = text.match(/^.+?[.!?](?=\s|$)/)?.[0];
  if (first && first.length >= 60 && first.length <= 160) return first;
  return `${text.slice(0, 157).replace(/[\s,;:]+\S*$/, '')}…`;
}
const metaDescription = snippet(description);
const fullTitle = title.includes('Vaanika') ? title : `${title} | Vaanika`;
const ogUrl = new URL(ogImage, SITE_URL).href;
---

<!doctype html>
<html lang="en-IN" class:list={[{ 'is-preview': PREVIEW }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {INDEXABLE ? (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta name="theme-color" content="#0B1020" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vaanika" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Vaanika, private jets and helicopters for Indian weddings"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogUrl} />

    <Font cssVariable="--font-display" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-body" preload />
    <script is:inline>
      // Before first paint: "js", and "motion" (scroll choreography, 3D) unless the visitor asked
      // for reduced motion or Save-Data (src/motion). ?motion=off turns it off for testing.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var c = navigator.connection;
          if (
            !matchMedia('(prefers-reduced-motion: reduce)').matches &&
            !(c && c.saveData) &&
            !/[?&]motion=off/.test(location.search)
          )
            d.classList.add('motion');
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    {
      /* Cookieless Vercel Web Analytics and Speed Insights, only when switched on (WEBSITE.md §4). */
      ANALYTICS && (
        <>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
          <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
        </>
      )
    }
    {
      /* Google Ads conversion tag, only when PUBLIC_GOOGLE_ADS_ID is set. */
      GOOGLE_ADS_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}
          ></script>
          <script is:inline define:vars={{ id: GOOGLE_ADS_ID }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', id);
          </script>
        </>
      )
    }
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <PreviewBanner />
    <Header pageName={pageName} planHref={planHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer pageName={pageName} />
    <StickyContact pageName={pageName} />
    <script>
      import { startSite } from '../scripts/site';
      startSite();
      // scroll choreography and 3D: a separate chunk, only when motion is welcome
      if (document.documentElement.classList.contains('motion'))
        void import('../motion/index').then((m) => m.startMotion());
      // ?debug=3d: which tier this device got and what each 3D stage is doing (for testing on phones)
      if (/[?&]debug=3d\b/.test(location.search)) void import('../motion/debug').then((m) => m.showDebug());
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
