---
/**
 * A 3D stage: where one of the page's 3D moments is drawn (src/three). Decorative (aria-hidden): every
 * fact it shows is also in the page's text. Holds the rendered stills of the moment, shown under
 * reduced motion, without WebGL, on low-end devices and until the 3D is ready; with several stills
 * the chapter shows the one for the current step.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// tiny blurred copies of the stills, written into the page (scripts/still-placeholders.py)
import placeholders from '../assets/3d/stills/placeholders.json';

interface Props {
  name: string;
  stills?: ImageMetadata[];
  class?: string;
  sizes?: string;
  caption?: string;
  /** scene variant, read by the scene module (data-mode) */
  mode?: string;
  /** how the stills fill the stage: cover (default) or contain (a transparent still, e.g. the lotus) */
  fit?: 'cover' | 'contain';
  /** eager for a still that must be there the moment its section arrives */
  loading?: 'lazy' | 'eager';
}

const { name, stills = [], class: cls, sizes = '(max-width: 767px) 100vw, 60vw', caption = 'Illustrative 3D', mode, fit = 'cover', loading = 'lazy' } = Astro.props;
// the first still's own placeholder: there from the first frame, under the still while it loads
// (not for a transparent still, which would show it around its edges; that one loads eagerly)
const first = stills[0]?.src.split('/').pop()?.split('.')[0] ?? '';
const placeholder = fit === 'contain' ? undefined : (placeholders as Record<string, string>)[first];
---

<div class:list={['stage', cls, { 'stage--contain': fit === 'contain' }]} data-stage={name} data-mode={mode} aria-hidden="true">
  {placeholder && <img class="stage__ph" src={placeholder} alt="" width="40" height="40" decoding="async" />}
  {
    stills.map((src, i) => (
      <Picture
        src={src}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600].filter((w) => w <= src.width)}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'low' : undefined}
        class:list={['stage__still', { 'is-active': i === 0 }]}
        data-still={i}
      />
    ))
  }
  <slot />
  {caption && <span class="illustrative stage__caption">{caption}</span>}
</div>

<style>
  .stage {
    position: relative;
    min-height: 0;
    /* the softened placeholder is drawn slightly larger than the stage; never past its edges */
    overflow: hidden;
  }

  .stage :global(.stage__still) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-panel) var(--ease-in-out);
  }

  .stage--contain :global(.stage__still),
  .stage--contain .stage__ph {
    object-fit: contain;
  }

  /* the placeholder: the still in miniature, softened; covered by the still once it loads */
  .stage__ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(10px);
    transform: scale(1.04);
    transition: opacity var(--dur-fade) ease;
  }

  :global(.gl) .stage:global(.is-live) .stage__ph {
    opacity: 0;
  }

  .stage :global(.stage__still.is-active) {
    opacity: 1;
  }

  /* the live 3D takes over from the still once its first frame is on screen */
  :global(.gl) .stage:global(.is-live) :global(.stage__still) {
    opacity: 0;
    transition-duration: var(--dur-fade);
  }

  .stage__caption {
    position: absolute;
    right: 12px;
    bottom: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(5, 7, 15, 0.55);
    font-size: 10.5px;
  }
</style>
