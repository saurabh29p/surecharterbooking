---
/** Planner and hotel sign-up → POST {API}/api/public/partners (WEBSITE.md §5). */
import { company } from '../config/company';
import { whatsappLink } from '../config/site';
import Icon from './Icon.astro';

const wa = whatsappLink(
  'For planners',
  'I’m a wedding planner and would like to partner with you.',
);
---

<div class="pf" data-partner>
  <form class="pf__form" aria-label="Become a partner planner" novalidate data-partner-form>
    <fieldset class="pf__roles pf__wide">
      <legend class="pf__legend">I work as</legend>
      <div class="pf__role-options">
        <label class="pf__role">
          <input type="radio" name="role" value="PLANNER" checked />
          <span>Wedding planner</span>
        </label>
        <label class="pf__role">
          <input type="radio" name="role" value="HOTEL" />
          <span>Hotel wedding team</span>
        </label>
      </div>
    </fieldset>
    <label class="field">
      Your name
      <input name="name" type="text" autocomplete="name" aria-describedby="pf-name-err" />
      <span class="field__error" id="pf-name-err" data-error="name"></span>
    </label>
    <label class="field">
      Firm or hotel
      <input name="firm" type="text" autocomplete="organization" aria-describedby="pf-firm-err" />
      <span class="field__error" id="pf-firm-err" data-error="firm"></span>
    </label>
    <label class="field">
      WhatsApp number
      <input
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        placeholder="98123 45678"
        aria-describedby="pf-phone-err"
      />
      <span class="field__error" id="pf-phone-err" data-error="phone"></span>
    </label>
    <label class="field">
      City
      <input name="city" type="text" autocomplete="address-level2" placeholder="e.g. Delhi" />
    </label>
    <label class="field">
      Email (optional)
      <input name="email" type="email" autocomplete="email" aria-describedby="pf-email-err" />
      <span class="field__error" id="pf-email-err" data-error="email"></span>
    </label>
    <label class="field">
      Weddings a year (optional)
      <input
        name="weddingsPerYear"
        type="text"
        inputmode="numeric"
        placeholder="e.g. 12"
        aria-describedby="pf-wpy-err"
      />
      <span class="field__error" id="pf-wpy-err" data-error="weddingsPerYear"></span>
    </label>
    <label class="field pf__wide">
      Instagram (optional)
      <input name="instagram" type="text" placeholder="@yourfirm" />
    </label>
    <label class="field pf__wide">
      Anything we should know? (optional)
      <textarea name="message" maxlength="1000" rows="3"></textarea>
    </label>
    <div class="pf__trap" aria-hidden="true">
      <label>
        Company website <input name="companyWebsite" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <div class="pf__wide pf__checks">
      <label class="check">
        <input type="checkbox" name="consent" aria-describedby="pf-consent-err" />
        <span>
          I agree that Vaanika may contact me about partnering. My details are used only for this,
          as the <a href="/legal/privacy/">privacy notice</a> explains.
        </span>
      </label>
      <span class="field__error" id="pf-consent-err" data-error="consent"></span>
      <label class="check">
        <input type="checkbox" name="marketingConsent" />
        <span>Also send me occasional news and offers from Vaanika (optional).</span>
      </label>
    </div>
    <p class="pf__alert pf__wide" role="alert" data-alert hidden></p>
    <button class="btn btn--ivory btn--lg btn--block pf__wide" type="submit">
      <span class="spinner" data-spinner hidden></span>
      <span data-label>Become a partner planner</span>
    </button>
    <p class="pf__note pf__wide">We reply {company.replyTime}. No spam, ever.</p>
  </form>
  <div class="pf__done" data-done hidden tabindex="-1">
    <span class="pf__tick" aria-hidden="true">
      <Icon name="check" size={28} stroke={2.4} />
    </span>
    <h3 class="pf__done-title display">Thank you. We’ll be in touch.</h3>
    <p>Our partnerships team will call or message you {company.replyTime}.</p>
    <a class="btn btn--gold" href={wa} data-tap="WHATSAPP">
      <Icon name="chat" size={18} stroke={2} />
      Message us on WhatsApp
    </a>
  </div>
</div>

<style>
  .pf__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding: 36px;
    border-radius: 26px;
    background: rgba(14, 19, 40, 0.94);
    border: 1px solid #2a3050;
  }

  [hidden] {
    display: none !important;
  }

  .pf__wide {
    grid-column: 1 / -1;
  }

  .pf__roles {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .pf__legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--label);
  }

  .pf__role-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pf__role {
    position: relative;
    cursor: pointer;
  }

  .pf__role input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .pf__role span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--field-line);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-3);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .pf__role:hover span {
    border-color: var(--gold-dark);
    color: var(--ivory);
  }

  .pf__role input:checked + span {
    border-color: var(--gold);
    background: rgba(212, 178, 106, 0.14);
    color: var(--gold-light);
  }

  .pf__role input:focus-visible + span {
    outline: 2px solid var(--gold-light);
    outline-offset: 3px;
  }

  .pf__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .pf__checks {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pf__alert {
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 155, 138, 0.5);
    background: rgba(255, 155, 138, 0.08);
    color: #ffd2c9;
    font-size: 14px;
  }

  .pf__alert :global(a) {
    color: var(--gold-light);
    font-weight: 700;
  }

  .pf__note {
    font-size: 12.5px;
    color: var(--faint);
    text-align: center;
  }

  .pf__done {
    padding: 44px 36px;
    border-radius: 26px;
    background: rgba(14, 19, 40, 0.96);
    border: 1px solid var(--gold-dark);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: var(--text-3);
    outline: none;
  }

  .pf__tick {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-gradient);
    color: var(--midnight);
  }

  .pf__done-title {
    font-size: 30px;
    color: var(--ivory);
  }

  @media (max-width: 599px) {
    .pf__form {
      grid-template-columns: 1fr;
      padding: 24px 18px;
      gap: 14px;
    }
  }
</style>

<script>
  import { API_URL } from '../config/site';
  import { partnerBody, partnerProblems, type PartnerFormValues } from '../lib/partner';
  import { currentAttribution, gtagConversion } from '../scripts/site';

  const openedAt = performance.now();
  const root = document.querySelector<HTMLElement>('[data-partner]');
  const form = root?.querySelector<HTMLFormElement>('[data-partner-form]');

  function values(f: HTMLFormElement): PartnerFormValues {
    const d = new FormData(f);
    const s = (k: string) => (d.get(k) as string | null) ?? '';
    return {
      name: s('name'),
      firm: s('firm'),
      role: s('role') === 'HOTEL' ? 'HOTEL' : 'PLANNER',
      city: s('city'),
      phone: s('phone'),
      email: s('email'),
      instagram: s('instagram'),
      weddingsPerYear: s('weddingsPerYear'),
      message: s('message'),
      consent: d.get('consent') === 'on',
      marketingConsent: d.get('marketingConsent') === 'on',
      companyWebsite: s('companyWebsite'),
    };
  }

  function show(f: HTMLFormElement, errors: Record<string, string>) {
    f.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
      const key = el.dataset.error!;
      el.textContent = errors[key] ?? '';
      f.querySelector(`[name="${key}"]`)?.setAttribute(
        'aria-invalid',
        errors[key] ? 'true' : 'false',
      );
    });
  }

  if (root && form) {
    const touched = new Set<string>();
    form.addEventListener('focusout', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (!name || name === 'role') return;
      touched.add(name);
      const all = partnerProblems(values(form));
      show(form, Object.fromEntries([...touched].filter((k) => all[k]).map((k) => [k, all[k]!])));
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const alert = form.querySelector<HTMLElement>('[data-alert]')!;
      alert.hidden = true;
      const v = values(form);
      const problems = partnerProblems(v);
      show(form, problems);
      if (Object.keys(problems).length) {
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const label = form.querySelector<HTMLElement>('[data-label]')!;
      btn.disabled = true;
      form.querySelector<HTMLElement>('[data-spinner]')!.hidden = false;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(`${API_URL}/api/public/partners`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(partnerBody(v, performance.now() - openedAt, currentAttribution())),
        });
        if (res.ok) {
          form.hidden = true;
          const done = root.querySelector<HTMLElement>('[data-done]')!;
          done.hidden = false;
          done.focus();
          gtagConversion('partner');
          return;
        }
        const data = (await res.json().catch(() => ({}))) as {
          message?: string;
          fields?: Record<string, string>;
        };
        if (res.status === 400 && data.fields) show(form, data.fields);
        else throw new Error(data.message ?? 'failed');
      } catch {
        alert.textContent = 'Sorry, we couldn’t send this. Please message us on WhatsApp instead. ';
        const a = root
          .querySelector<HTMLAnchorElement>('[data-done] a')!
          .cloneNode(true) as HTMLAnchorElement;
        a.className = '';
        a.textContent = 'Open WhatsApp';
        alert.append(a);
        alert.hidden = false;
      } finally {
        btn.disabled = false;
        form.querySelector<HTMLElement>('[data-spinner]')!.hidden = true;
        label.textContent = 'Become a partner planner';
      }
    });
  }
</script>
