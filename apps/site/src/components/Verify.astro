---
/**
 * A fact written as a best estimate (WEBSITE.md §10): flight times, seats, airport details.
 * Preview builds mark every `.verify` (here and in Markdown) with a dotted underline and a
 * "verify" tag; each is listed in apps/site/VERIFY.md. The launched site shows plain text.
 */
import { PREVIEW } from '../config/site';
---

{PREVIEW ? (
  <span class="verify">
    <slot />
  </span>
) : (
  <slot />
)}
