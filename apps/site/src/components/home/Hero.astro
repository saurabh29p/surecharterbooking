---
/**
 * Hero (mockup: HERO VIDEO). The poster is the LCP image: eager, high priority, preloaded by the page.
 * Behind the headline the brand film plays as a muted, seamless background loop (lake palace, jet,
 * helicopter; no text): 16:9 on screens 768 px and wider, 9:16 on phones, each with its own poster
 * (the film's first frame). It starts loading only after the poster has painted, never under reduced
 * motion or Save-Data (WEBSITE.md §4), and a small control pauses it (WCAG 2.2.2).
 */
import { PHONE, heroPosters } from './poster';
import Icon from '../Icon.astro';
import { videoUrl } from '../../lib/video';

interface Props {
  planHref: string;
}

const { planHref } = Astro.props;
const p = await heroPosters();
const TITLE = 'The arrival they’ll talk about for a lifetime.';
---

<section class="hero" aria-label="Introduction" data-chapter="hero">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media={PHONE} type="image/avif" srcset={p.tallAvif.srcSet.attribute} sizes="100vw" />
      <source media={PHONE} type="image/webp" srcset={p.tallWebp.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={p.wideAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={p.wideWebp.srcSet.attribute} sizes="100vw" />
      <img
        src={p.fallback.src}
        width="1280"
        height="720"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="hero__poster"
      />
    </picture>
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
      data-src-wide={videoUrl('hero-film-1280x720.mp4')}
      data-src-phone={videoUrl('hero-film-720x1280.mp4')}
    ></video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <!-- with motion: the film dims into the night sky as the page scrolls (motion/chapters/hero.ts) -->
  <div class="hero__dim" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">
      <span class="hero__eyebrow-long">Private jets &amp; helicopters for Indian weddings</span>
      <span class="hero__eyebrow-short">Private jets &amp; helicopters · Weddings</span>
    </p>
    <h1 class="hero__title display">
      {TITLE.split(' ').map((w) => <span class="hero__w">{w} </span>)}
    </h1>
    <p class="hero__sub hero__sub--long">
      Your family and closest guests, flown from any Indian city to Udaipur, Jaipur, Goa and beyond
      — only with DGCA-approved operators, at one written, all-in price.
    </p>
    <p class="hero__sub hero__sub--short">
      Only DGCA-approved operators. One written, all-in price.
    </p>
    <div class="hero__actions">
      <a class="btn btn--gold btn--lg" href={planHref}>
        Plan my wedding flight <Icon name="arrow" size={18} stroke={2} class="btn__arrow" />
      </a>
    </div>
  </div>
  <p class="illustrative hero__caption">Illustrative film</p>
  <button type="button" class="hero__pause" aria-label="Pause the background film" aria-pressed="false" hidden data-hero-pause>
    <svg class="hero__pause-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
      <path class="i-pause" d="M7 4h3.5v16H7zM13.5 4H17v16h-3.5z" fill="currentColor"></path>
      <path class="i-play" d="M8 4.5l12 7.5-12 7.5z" fill="currentColor"></path>
    </svg>
  </button>
</section>

<style>
  .hero {
    position: relative;
    height: min(820px, calc(100svh - var(--header-h) - 38px));
    min-height: 640px;
    overflow: hidden;
    background: var(--hero-black);
  }

  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* the film is bright in places (the jet's white fuselage): keep the text side dark enough to read */
  .hero__shade {
    background:
      linear-gradient(
        90deg,
        rgba(5, 7, 15, 0.9) 0%,
        rgba(5, 7, 15, 0.74) 38%,
        rgba(5, 7, 15, 0.3) 66%,
        rgba(5, 7, 15, 0.08) 100%
      ),
      linear-gradient(0deg, rgba(11, 16, 32, 1) 0%, rgba(11, 16, 32, 0) 32%);
  }

  .hero__title,
  .hero__sub,
  .hero__eyebrow {
    text-shadow: 0 2px 22px rgba(5, 7, 15, 0.55);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding-bottom: 92px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero__eyebrow {
    margin-bottom: 22px;
  }

  .hero__eyebrow-short,
  .hero__sub--short {
    display: none;
  }

  .hero__title {
    max-width: 860px;
    font-size: clamp(48px, 6.6vw, 98px);
    line-height: 1.02;
    letter-spacing: -0.012em;
  }

  .hero__sub {
    margin-top: 26px;
    max-width: 580px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__caption {
    position: absolute;
    right: calc(var(--gutter) + 84px);
    bottom: 24px;
    z-index: 2;
  }

  @media (max-width: 767px) {
    .hero {
      height: 560px;
      min-height: 0;
    }

    .hero__shade {
      background: linear-gradient(
        0deg,
        #0b1020 0%,
        rgba(11, 16, 32, 0.86) 40%,
        rgba(11, 16, 32, 0.5) 62%,
        rgba(11, 16, 32, 0.12) 82%
      );
    }

    .hero__content {
      padding-bottom: 26px;
    }

    .hero__eyebrow {
      margin-bottom: 0;
    }

    .hero__eyebrow-long,
    .hero__sub--long,
    .hero__actions {
      display: none;
    }

    .hero__eyebrow-short,
    .hero__sub--short {
      display: block;
    }

    .hero__title {
      margin-top: 12px;
      font-size: clamp(34px, 10.3vw, 44px);
      line-height: 1.05;
    }

    .hero__sub {
      margin-top: 12px;
      font-size: 15px;
      line-height: 1.55;
    }

    .hero__caption {
      top: 14px;
      right: var(--gutter);
      bottom: auto;
      font-size: 10.5px;
    }
  }

  /* ---------- Pause control (WCAG 2.2.2: moving content can be paused) ---------- */

  .hero__pause {
    position: absolute;
    right: var(--gutter);
    bottom: 18px;
    z-index: 3;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 237, 226, 0.35);
    border-radius: 50%;
    background: rgba(11, 16, 32, 0.45);
    color: var(--ivory);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      transform 0.05s ease;
  }

  .hero__pause[hidden] {
    display: none;
  }

  .hero__pause:hover {
    border-color: var(--gold);
  }

  .hero__pause:active {
    transform: scale(0.96);
  }

  .hero__pause .i-play,
  .hero__pause[aria-pressed='true'] .i-pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .i-play {
    display: inline;
  }

  @media (max-width: 767px) {
    .hero__pause {
      top: 40px;
      bottom: auto;
      width: 36px;
      height: 36px;
    }
  }
  /* ---------- With motion: the film recedes, the words lift away line by line ---------- */

  .hero__dim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #0b1020;
    opacity: 0;
    pointer-events: none;
  }

  :global(.motion-ready) .hero__media {
    transform: scale(calc(1 + var(--p, 0) * 0.08));
    transform-origin: 50% 38%;
  }

  :global(.motion-ready) .hero__dim {
    opacity: calc(var(--p, 0) * 1.25);
  }

  :global(.motion-ready) .hero [data-l] {
    --lp: clamp(0, var(--p, 0) * 2.6 - var(--l) * 0.16, 1);
    transform: translate3d(0, calc(var(--lp) * -46px), 0);
    opacity: calc(1 - var(--lp));
  }

  .hero__w {
    display: inline-block;
    white-space: pre;
  }
</style>

<script>
  import { PHONE } from './poster-media';

  // Background film: after the page has settled, when motion and data are welcome; the phone cut on
  // narrow screens. The pause control appears once it plays.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const pause = document.querySelector<HTMLButtonElement>('[data-hero-pause]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;
  if (video && !reduce && !saveData) {
    const start = () => {
      video.src = (matchMedia(PHONE).matches ? video.dataset.srcPhone : video.dataset.srcWide) ?? '';
      video.addEventListener(
        'playing',
        () => {
          video.classList.add('is-playing');
          if (pause) pause.hidden = false;
        },
        { once: true },
      );
      void video.play().catch(() => {});
    };
    // start once the page has settled (a second after load, then an idle moment), so starting the
    // decoder never competes with the visitor's first taps; the poster is its first frame anyway
    const whenIdle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(start, { timeout: 1500 })
        : setTimeout(start, 200);
    const later = () => setTimeout(whenIdle, 1000);
    if (document.readyState === 'complete') later();
    else addEventListener('load', later, { once: true });
  }
  pause?.addEventListener('click', () => {
    if (!video) return;
    const paused = pause.getAttribute('aria-pressed') === 'true';
    if (paused) void video.play().catch(() => {});
    else video.pause();
    pause.setAttribute('aria-pressed', String(!paused));
    pause.setAttribute('aria-label', paused ? 'Pause the background film' : 'Play the background film');
  });
</script>
