---
/**
 * Hero (mockup: HERO VIDEO). The poster is the LCP image: eager, high priority, preloaded by the page.
 * The loop video starts loading only after the poster has painted, never under reduced motion or
 * Save-Data, and not below 768 px (WEBSITE.md §4).
 */
import { Picture } from 'astro:assets';
import poster from '../../assets/photos/hero-poster.jpg';
import Icon from '../Icon.astro';

interface Props {
  planHref: string;
}

const { planHref } = Astro.props;
---

<section class="hero" aria-label="Introduction">
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={poster}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1280]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      class="hero__poster"
    />
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
      data-src="/video/hero-loop-720p.mp4"
    ></video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">
      <span class="hero__eyebrow-long">Private jets &amp; helicopters for Indian weddings</span>
      <span class="hero__eyebrow-short">Private jets &amp; helicopters · Weddings</span>
    </p>
    <h1 class="hero__title display">The arrival they’ll talk about for a lifetime.</h1>
    <p class="hero__sub hero__sub--long">
      Your family and closest guests, flown from any Indian city to Udaipur, Jaipur, Goa and beyond
      — only with DGCA-approved operators, at one written, all-in price.
    </p>
    <p class="hero__sub hero__sub--short">
      Only DGCA-approved operators. One written, all-in price.
    </p>
    <div class="hero__actions">
      <a class="btn btn--gold btn--lg" href={planHref}>
        Plan my wedding flight <Icon name="arrow" size={18} stroke={2} class="btn__arrow" />
      </a>
      <a class="btn btn--ghost btn--lg film-btn" href="/video/vaanika-film-720p.mp4" data-film-open>
        <span class="film-btn__play">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#0B1020" aria-hidden="true">
            <path d="M7 4l14 8-14 8z"></path>
          </svg>
        </span>
        Watch the film · 35s
      </a>
    </div>
  </div>
  <p class="illustrative hero__caption">Illustrative footage</p>
</section>

<dialog class="film" aria-label="Vaanika brand film" data-film>
  <button type="button" class="film__close" aria-label="Close the film" data-film-close>
    <Icon name="close" size={20} stroke={2} />
  </button>
  <video class="film__video" controls playsinline preload="none" data-film-video></video>
  <p class="illustrative film__caption">Illustrative film, made with computer graphics.</p>
</dialog>

<style>
  .hero {
    position: relative;
    height: min(820px, calc(100svh - var(--header-h) - 38px));
    min-height: 640px;
    overflow: hidden;
    background: var(--hero-black);
  }

  .hero__media,
  .hero__shade {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  .hero__shade {
    background:
      linear-gradient(
        90deg,
        rgba(5, 7, 15, 0.88) 0%,
        rgba(5, 7, 15, 0.55) 42%,
        rgba(5, 7, 15, 0.05) 75%
      ),
      linear-gradient(0deg, rgba(11, 16, 32, 1) 0%, rgba(11, 16, 32, 0) 32%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding-bottom: 92px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero__eyebrow {
    margin-bottom: 22px;
  }

  .hero__eyebrow-short,
  .hero__sub--short {
    display: none;
  }

  .hero__title {
    max-width: 860px;
    font-size: clamp(48px, 6.6vw, 98px);
    line-height: 1.02;
    letter-spacing: -0.012em;
  }

  .hero__sub {
    margin-top: 26px;
    max-width: 580px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    margin-top: 38px;
    flex-wrap: wrap;
    align-items: center;
  }

  .film-btn {
    padding: 10px 24px 10px 10px;
    gap: 12px;
    font-size: 15.5px;
  }

  .film-btn__play {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ivory);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s var(--ease-out);
  }

  .film-btn:hover .film-btn__play {
    transform: scale(1.08);
  }

  .hero__caption {
    position: absolute;
    right: calc(var(--gutter) + 84px);
    bottom: 24px;
    z-index: 2;
  }

  @media (max-width: 767px) {
    .hero {
      height: 560px;
      min-height: 0;
    }

    .hero__media :global(img) {
      object-position: 62% center;
    }

    .hero__shade {
      background: linear-gradient(
        0deg,
        #0b1020 0%,
        rgba(11, 16, 32, 0.75) 38%,
        rgba(11, 16, 32, 0.1) 70%
      );
    }

    .hero__content {
      padding-bottom: 26px;
    }

    .hero__eyebrow {
      margin-bottom: 0;
    }

    .hero__eyebrow-long,
    .hero__sub--long,
    .hero__actions {
      display: none;
    }

    .hero__eyebrow-short,
    .hero__sub--short {
      display: block;
    }

    .hero__title {
      margin-top: 12px;
      font-size: clamp(34px, 10.3vw, 44px);
      line-height: 1.05;
    }

    .hero__sub {
      margin-top: 12px;
      font-size: 15px;
      line-height: 1.55;
    }

    .hero__caption {
      top: 14px;
      right: var(--gutter);
      bottom: auto;
      font-size: 10.5px;
    }
  }

  /* ---------- Film ---------- */

  .film {
    width: min(1100px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #000;
    color: var(--ivory);
    overflow: visible;
  }

  .film::backdrop {
    background: rgba(5, 7, 15, 0.86);
  }

  .film[open] {
    animation: film-in 0.25s var(--ease-out);
  }

  @keyframes film-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .film__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    background: #000;
  }

  .film__caption {
    position: absolute;
    left: 0;
    bottom: -28px;
  }

  .film__close {
    position: absolute;
    top: -54px;
    right: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 237, 226, 0.4);
    border-radius: 50%;
    background: rgba(11, 16, 32, 0.6);
    color: var(--ivory);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      transform 0.05s ease;
  }

  .film__close:hover {
    border-color: var(--gold);
  }

  .film__close:active {
    transform: scale(0.96);
  }
</style>

<script>
  // Loop video: after the poster has painted, on wide screens, when motion and data are welcome.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;
  const wide = matchMedia('(min-width: 768px)').matches;
  if (video && !reduce && !saveData && wide) {
    const start = () => {
      video.src = video.dataset.src ?? '';
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      void video.play().catch(() => {});
    };
    if (document.readyState === 'complete') setTimeout(start, 300);
    else addEventListener('load', () => setTimeout(start, 300), { once: true });
  }

  // The film opens in a pop-up and loads only then.
  const film = document.querySelector<HTMLDialogElement>('[data-film]');
  const filmVideo = document.querySelector<HTMLVideoElement>('[data-film-video]');
  document.querySelectorAll<HTMLAnchorElement>('[data-film-open]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!film || !filmVideo) return;
      e.preventDefault();
      if (!filmVideo.src) filmVideo.src = a.href;
      film.showModal();
      void filmVideo.play().catch(() => {});
    }),
  );
  film?.querySelector('[data-film-close]')?.addEventListener('click', () => film.close());
  film?.addEventListener('click', (e) => {
    if (e.target === film) film.close();
  });
  film?.addEventListener('close', () => filmVideo?.pause());
</script>
