---
/** The Shreeji Arrival (mockup: SIGNATURE EXPERIENCE). The photo is a composite: captioned "Illustrative". */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import photo from '../../assets/photos/shreeji-arrival-composite.jpg';
import Stage from '../Stage.astro';

const stills = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/3d/stills/shreeji.png', { eager: true }),
).map((m) => m.default);
---

<section id="shreeji" class="shreeji" aria-labelledby="shreeji-h" data-chapter="shreeji">
  <!-- With motion: pinned; the scroll brings the helicopter down onto the lawn (three/scenes/shreeji.ts).
       Without: the composite photo. -->
  <div class="shreeji__pin">
  <figure class="shreeji__photo">
    <Picture formats={['avif', 'webp']}
      src={photo}
      alt="A bride and groom walking from a black helicopter parked on a lawn"
      widths={[640, 960, 1280, 1527]}
      sizes="100vw"
      loading="lazy"
    />
    <figcaption class="illustrative shreeji__ill">Illustrative composite</figcaption>
  </figure>
  <Stage name="shreeji" mode="arrival" class="shreeji__stage" stills={stills} sizes="100vw" />
  <div class="shreeji__shade" aria-hidden="true"></div>
  <div class="container shreeji__content">
    <div class="shreeji__text reveal">
      <p class="eyebrow">Signature experience</p>
      <h2 id="shreeji-h" class="shreeji__title display">
        The Shreeji Arrival
      </h2>
      <p class="shreeji__lead">
        The bride or groom arrives by helicopter, timed to the music, with a flower shower where
        permission allows. We coordinate the landing spot and permissions with the operator and your
        venue, and plan the minute-by-minute with your planner.
      </p>
      <a class="btn btn--outline btn--lg shreeji__btn" href="/helicopter-arrivals/">
        Ask about the Shreeji Arrival
      </a>
    </div>
  </div>
  </div>
</section>

<style>
  .shreeji {
    position: relative;
    padding: 170px 0;
    overflow: hidden;
  }

  .shreeji__photo,
  .shreeji__shade {
    position: absolute;
    inset: 0;
  }

  .shreeji__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% center;
  }

  .shreeji__ill {
    position: absolute;
    right: var(--gutter);
    bottom: 20px;
    z-index: 2;
  }

  .shreeji__shade {
    background:
      linear-gradient(
        90deg,
        rgba(11, 16, 32, 0.97) 0%,
        rgba(11, 16, 32, 0.85) 36%,
        rgba(11, 16, 32, 0.15) 64%,
        rgba(11, 16, 32, 0) 100%
      ),
      linear-gradient(0deg, rgba(11, 16, 32, 0.7) 0%, rgba(11, 16, 32, 0) 30%);
  }

  .shreeji__content {
    position: relative;
  }

  .shreeji__text {
    max-width: 560px;
  }

  .shreeji__title {
    margin-top: 16px;
    font-size: clamp(42px, 5.6vw, 84px);
    line-height: 1;
  }

  .shreeji__lead {
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-2);
  }

  .shreeji__btn {
    margin-top: 34px;
  }

  @media (max-width: 767px) {
    .shreeji {
      padding: 300px 0 64px;
    }

    .shreeji__photo :global(img) {
      object-position: 70% top;
      height: 380px;
    }

    .shreeji__shade {
      background: linear-gradient(
        0deg,
        #0b1020 0%,
        #0b1020 calc(100% - 380px),
        rgba(11, 16, 32, 0.1) calc(100% - 120px)
      );
    }

    .shreeji__ill {
      top: 14px;
      bottom: auto;
    }

    .shreeji__lead {
      font-size: 16.5px;
    }
  }
  /* ---------- With motion: the 3D arrival, pinned ---------- */

  :global(.shreeji__stage) {
    display: none;
  }

  :global(.motion-ready) .shreeji {
    height: calc(100svh - var(--header-h) + 150svh);
    padding: 0;
    overflow: visible;
  }

  :global(.motion-ready) .shreeji__pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  :global(.motion-ready) .shreeji__photo {
    display: none;
  }

  :global(.motion-ready) :global(.shreeji__stage) {
    display: block;
    position: absolute;
    inset: 0;
  }

  :global(.motion-ready) .shreeji__shade {
    background: linear-gradient(
      90deg,
      rgba(11, 16, 32, 0.92) 0%,
      rgba(11, 16, 32, 0.72) 32%,
      rgba(11, 16, 32, 0) 58%
    );
  }

  :global(.motion-ready) .shreeji__content {
    width: 100%;
  }

  @media (max-width: 767px) {
    :global(.motion-ready) .shreeji__pin {
      align-items: flex-end;
      padding-bottom: 28px;
    }

    /* phones: the scene in the upper part, the words below it */
    :global(.motion-ready) :global(.shreeji__stage) {
      inset: 0 0 auto 0;
      height: 60%;
    }

    :global(.motion-ready) .shreeji__shade {
      background: linear-gradient(0deg, #0b1020 0%, #0b1020 40%, rgba(11, 16, 32, 0.85) 46%, rgba(11, 16, 32, 0) 56%);
    }

    :global(.motion-ready) .shreeji__title {
      font-size: 40px;
    }

    :global(.motion-ready) .shreeji__lead {
      margin-top: 14px;
      font-size: 15.5px;
      line-height: 1.6;
    }

    :global(.motion-ready) .shreeji__btn {
      margin-top: 20px;
    }
  }
</style>
