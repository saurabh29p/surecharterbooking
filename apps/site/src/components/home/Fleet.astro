---
/**
 * Choose your arrival: five aircraft classes (mockup), each with an illustrative photo of a typical
 * aircraft in that class. Seat counts are typical; marked to verify. Photos: Wikimedia Commons
 * (credits below the grid, as their licences ask) and the site's own placeholder; registrations and
 * airline marks were removed (WEBSITE.md §7), see design/photos/README.md.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Verify from '../Verify.astro';
import Stage from '../Stage.astro';
import helicopter from '../../assets/photos/fleet/helicopter.jpg';
import lightJet from '../../assets/photos/fleet/light-jet.jpg';
import superMid from '../../assets/photos/fleet/super-midsize.jpg';
import heavyJet from '../../assets/photos/fleet/heavy-jet.jpg';
import group from '../../assets/photos/fleet/group-charter.jpg';

const CLASSES: { name: string; seats: string; use: string; img: ImageMetadata; alt: string; featured?: boolean }[] = [
  {
    name: 'Helicopter',
    seats: 'Up to 5–6 guests',
    use: 'Airport to venue. The grand entrance.',
    img: helicopter,
    alt: 'A white twin-engine helicopter parked on a grass helipad',
  },
  {
    name: 'Light jet',
    seats: 'About 6–7 guests',
    use: 'The couple and closest family.',
    img: lightJet,
    alt: 'A white light business jet parked on an airport apron under a stormy sky',
  },
  {
    name: 'Super-midsize',
    seats: 'About 8–9 guests',
    use: 'One family side, coast to coast.',
    img: superMid,
    alt: 'A white super-midsize business jet parked on an apron',
  },
  {
    name: 'Heavy jet',
    seats: 'About 12–14 guests',
    use: 'The full VIP circle, room to celebrate.',
    img: heavyJet,
    alt: 'A large private jet on the tarmac at sunset',
  },
  {
    name: 'Group charter',
    seats: '50 guests and more',
    use: 'The whole baraat, one departure.',
    img: group,
    alt: 'A passenger airliner taking off, silhouetted against a dusk sky',
    featured: true,
  },
];

// Rendered stills of the 3D showroom, one per class (src/assets/3d/stills/fleet-<n>.png)
const stills = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/3d/stills/fleet-*.png', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
---

<section id="fleet" class="fleet" aria-labelledby="fleet-h">
  <!-- With motion: a pinned showroom stepping through the classes (motion/chapters/fleet.ts, three/scenes/showroom.ts).
       Without: the grid of cards. -->
  <div class="fleet__track" data-chapter="fleet">
  <div class="container fleet__pin">
    <div class="fleet__head reveal">
      <p class="eyebrow">Choose your arrival</p>
      <h2 id="fleet-h" class="h2 fleet__title">
        Five ways to fly in. One team for all of it.
      </h2>
    </div>
    <Stage name="showroom" class="fleet__stage" stills={stills} sizes="(max-width: 767px) 100vw, 60vw" />
    <div class="fleet__grid">
      {CLASSES.map((c, i) => (
        <a
          href="/aircraft/"
          class:list={['fleet__card card-lift reveal', { 'is-featured': c.featured, 'is-active': i === 0 }]}
        >
          <span class="fleet__photo photo-zoom">
            <Picture
              src={c.img}
              alt={c.alt}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 767px) 74vw, (max-width: 1099px) 33vw, 240px"
              loading="lazy"
            />
            <span class="illustrative fleet__ill">Illustrative</span>
          </span>
          <div class="fleet__body">
            <h3 class="fleet__name display">{c.name}</h3>
            <p class="fleet__seats num">
              <Verify>{c.seats}</Verify>
            </p>
            <p class="fleet__use">{c.use}</p>
          </div>
        </a>
      ))}
    </div>
    <ol class="fleet__steps" aria-hidden="true">
      {CLASSES.map((c, i) => (
        <li data-step={i} class:list={{ 'is-active': i === 0 }}>
          <span>{c.name}</span>
        </li>
      ))}
    </ol>
  </div>
  </div>
  <div class="container">
    <p class="fleet__note">
      Guest numbers are typical for each class; the exact aircraft decides the final count.
    </p>
    <p class="fleet__credits">
      Illustrative photos of typical aircraft, not Vaanika's or an operator's: helicopter by jan hendrik
      de wit (<a href="https://commons.wikimedia.org/wiki/File:Airbus_Helicopter_H145_2018.jpg">CC0</a>);
      light and super-midsize jets by Acroterion
      (<a href="https://commons.wikimedia.org/wiki/File:Embraer_Phenom_300_N235EE_FDK_MD2.jpg">1</a>,
      <a href="https://commons.wikimedia.org/wiki/File:Cessna_Citation_Latitude_N980JF_FDK_MD2.jpg">2</a>,
      <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>); airliner by Maarten
      Visser (<a href="https://commons.wikimedia.org/wiki/File:Hello_A320_sunset_(7385671502).jpg">photo</a>,
      <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a>), via Wikimedia Commons.
      Cropped, with registrations and airline marks removed; the edited photos are shared under the
      same licences.
    </p>
  </div>
</section>

<style>
  .fleet {
    padding: 120px 0;
  }

  .fleet__title {
    max-width: 760px;
  }

  .fleet__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-top: 52px;
  }

  .fleet__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, #121833, #0e1328);
    color: var(--ivory);
    text-decoration: none;
  }

  .fleet__card:hover {
    color: var(--ivory);
  }

  .fleet__card.is-featured {
    border-color: var(--gold-dark);
    background: linear-gradient(180deg, #1a1e38, #0e1328);
  }

  .fleet__photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: #0b1020;
  }

  .fleet__ill {
    position: absolute;
    right: 10px;
    bottom: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(5, 7, 15, 0.55);
    font-size: 10.5px;
  }

  .fleet__body {
    display: block;
    padding: 20px 22px 26px;
  }

  .fleet__name {
    font-weight: 500;
    font-size: 23px;
    line-height: 1.2;
  }

  .fleet__seats {
    margin-top: 4px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--gold);
  }

  .fleet__use {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .fleet__note {
    margin-top: 20px;
    font-size: 13.5px;
    color: var(--faint);
  }

  .fleet__credits {
    margin-top: 8px;
    max-width: 900px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--faint);
  }

  .fleet__credits a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 1099px) {
    .fleet__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .fleet {
      padding: 80px 0;
    }

    /* Phones: a row to swipe through. */
    .fleet__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 74%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: 36px calc(var(--gutter) * -1) 0;
      padding: 4px var(--gutter) 12px;
      scroll-padding: 0 var(--gutter);
      scrollbar-width: none;
    }

    .fleet__grid::-webkit-scrollbar {
      display: none;
    }

    .fleet__card {
      scroll-snap-align: start;
    }
  }
  /* ---------- The showroom (motion on; motion/chapters/fleet.ts) ---------- */

  :global(.fleet__stage),
  .fleet__steps {
    display: none;
  }

  :global(.motion-ready) .fleet {
    padding-top: 40px;
  }

  :global(.motion-ready) .fleet__track {
    /* one window for the first class, then 70% of a window per class */
    height: calc(100svh - var(--header-h) + 4 * 70svh);
  }

  :global(.motion-ready) .fleet__pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    column-gap: 40px;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  :global(.motion-ready) .fleet__head {
    grid-column: 1 / -1;
  }

  :global(.motion-ready) :global(.fleet__stage) {
    display: block;
    grid-column: 1;
    grid-row: 2 / 4;
    margin: 12px 0 0 calc(var(--gutter) * -1);
  }

  :global(.motion-ready) .fleet .fleet__grid {
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    display: grid;
    grid-template-columns: none;
    grid-auto-columns: auto;
    grid-auto-flow: row;
    margin: 0;
    padding: 0;
    overflow: visible;
  }

  /* the five cards share one place; the active one shows */
  :global(.motion-ready) .fleet .fleet__grid .fleet__card {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(18px) scale(0.985);
    transition:
      opacity var(--dur-panel) var(--ease-in-out),
      transform var(--dur-reveal) var(--ease-out);
  }

  :global(.motion-ready) .fleet .fleet__grid .fleet__card.is-active {
    opacity: 1;
    transform: none;
    z-index: 1;
  }

  :global(.motion-ready) .fleet .fleet__grid .fleet__card:focus-visible {
    opacity: 1;
  }

  :global(.motion-ready) .fleet__steps {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .fleet__steps li {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: var(--line-strong);
    position: relative;
    transition: background-color var(--dur-panel) ease;
  }

  .fleet__steps li.is-active {
    background: var(--gold);
  }

  .fleet__steps span {
    position: absolute;
    top: 8px;
    left: 0;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--faint);
    opacity: 0;
    transition: opacity var(--dur-panel) ease;
  }

  .fleet__steps li.is-active span {
    opacity: 1;
    color: var(--gold-soft);
  }

  @media (max-width: 899px) {
    :global(.motion-ready) .fleet__pin {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      padding-top: 18px;
      padding-bottom: 14px;
    }

    :global(.motion-ready) :global(.fleet__stage) {
      grid-column: 1;
      grid-row: 2;
      margin: 0 calc(var(--gutter) * -1);
    }

    :global(.motion-ready) .fleet .fleet__grid {
      grid-column: 1;
      grid-row: 3;
    }

    :global(.motion-ready) .fleet__steps {
      grid-column: 1;
      grid-row: 4;
      margin-top: 12px;
    }

    .fleet__steps span {
      display: none;
    }

    /* phones: a compact card (photo beside the text) under the stage */
    :global(.motion-ready) .fleet .fleet__card {
      flex-direction: row;
    }

    :global(.motion-ready) .fleet .fleet__photo {
      flex: 0 0 36%;
      aspect-ratio: auto;
    }

    :global(.motion-ready) .fleet .fleet__body {
      padding: 14px 16px 16px;
    }

    :global(.motion-ready) .fleet .fleet__name {
      font-size: 20px;
    }

    :global(.motion-ready) .fleet .fleet__use {
      margin-top: 6px;
      font-size: 13.5px;
      line-height: 1.5;
    }
  }

  @media (max-width: 899px) and (max-height: 700px) {
    :global(.motion-ready) .fleet .fleet__use {
      display: none;
    }
  }
</style>
