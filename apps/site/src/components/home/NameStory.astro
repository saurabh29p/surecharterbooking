---
/** Why "Vaanika": the name story with the lotus mark (mockup). */
import type { ImageMetadata } from 'astro';
import mark from '../../assets/logo/vaanika-mark-colour-for-dark-bg.svg?url';
import Stage from '../Stage.astro';

const stills = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/3d/stills/bloom.jpg', { eager: true }),
).map((m) => m.default);
/** Each part's name beside the opening lotus (placed in the styles below). */
const LABELS = [
  { key: 'saraswati', text: 'Saraswati' },
  { key: 'lakshmi', text: 'Lakshmi' },
  { key: 'kali', text: 'Kali' },
  { key: 'chandra', text: 'the chandra' },
];
---

<section class="name" aria-labelledby="name-h" data-chapter="name">
  <!-- With motion: pinned; the lotus opens petal by petal, each named (three/scenes/mark.ts, mode bloom) -->
  <div class="name__pin">
  <div class="container name__inner reveal">
    <img src={mark} width="150" height="150" alt="" class="name__mark" loading="lazy" />
    <div class="name__bloom">
      <Stage name="mark" mode="bloom" class="name__stage" stills={stills} caption="" sizes="(max-width: 767px) 80vw, 420px" />
      <div class="name__labels" aria-hidden="true">
        {LABELS.map((l) => (
          <span class:list={['name__label', `name__label--${l.key}`]}>
            {l.text}
          </span>
        ))}
      </div>
    </div>
    <p class="eyebrow name__eyebrow">Why “Vaanika”</p>
    <h2 id="name-h" class="name__title display">
      The vaani of Saraswati, the shakti of Kalika, and the gold of Lakshmi.
    </h2>
    <p class="lead name__lead">
      Three petals in our lotus, one for each. Clear words, a protected journey, and an auspicious
      beginning to a new life together.
    </p>
    <a class="name__link" href="/about/">
      The story behind the name
    </a>
  </div>
  </div>
</section>

<style>
  .name {
    padding: 130px 0;
  }

  .name__inner {
    max-width: 980px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .name__mark {
    width: 140px;
    height: 140px;
  }

  .name__eyebrow {
    margin-top: 34px;
  }

  .name__title {
    margin-top: 16px;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.25;
    text-wrap: balance;
  }

  .name__lead {
    margin-top: 22px;
    max-width: 640px;
    font-size: 17px;
  }

  .name__link {
    margin-top: 22px;
    font-weight: 600;
    font-size: 15px;
  }

  @media (max-width: 767px) {
    .name {
      padding: 80px 0;
    }

    .name__mark {
      width: 104px;
      height: 104px;
    }
  }
  /* ---------- With motion: the lotus opens (motion/chapters/name.ts) ---------- */

  .name__bloom {
    display: none;
  }

  :global(.motion-ready) .name {
    height: calc(100svh - var(--header-h) + 120svh);
    padding: 0;
  }

  :global(.motion-ready) .name__pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
  }

  :global(.motion-ready) .name__mark {
    display: none;
  }

  :global(.motion-ready) .name__bloom {
    display: block;
    position: relative;
    width: min(46vh, 420px);
    aspect-ratio: 1;
  }

  :global(.motion-ready) .name__bloom :global(.name__stage) {
    position: absolute;
    inset: -12%;
  }

  .name__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* where each name sits (share of a square box round the mark) and when it appears */
  .name__label--saraswati {
    --x: 2%;
    --y: 46%;
    --at: 0.2;
  }

  .name__label--lakshmi {
    --x: 50%;
    --y: 99%;
    --at: 0.38;
  }

  .name__label--kali {
    --x: 98%;
    --y: 46%;
    --at: 0.56;
  }

  .name__label--chandra {
    --x: 50%;
    --y: 1%;
    --at: 0.72;
  }

  .name__label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    font-family: var(--font-display), serif;
    font-style: italic;
    font-size: clamp(17px, 1.6vw, 22px);
    color: var(--gold-light);
    white-space: nowrap;
    opacity: clamp(0, (var(--p, 1) - var(--at)) * 8, 1);
    text-shadow: 0 2px 16px rgba(5, 7, 15, 0.8);
  }

  /* the words arrive as the last petals open */
  :global(.motion-ready) .name__title,
  :global(.motion-ready) .name__lead,
  :global(.motion-ready) .name__link {
    opacity: clamp(0, (var(--p, 1) - 0.55) * 4, 1);
    transform: translate3d(0, calc((1 - clamp(0, (var(--p, 1) - 0.55) * 4, 1)) * 18px), 0);
  }

  :global(.motion-ready) .name__eyebrow {
    margin-top: 40px;
  }

  @media (max-width: 767px) {
    :global(.motion-ready) .name__bloom {
      width: min(68vw, 36svh);
    }

    :global(.motion-ready) .name__label {
      font-size: 15px;
    }

    :global(.motion-ready) .name__title {
      font-size: 24px;
    }

    :global(.motion-ready) .name__lead {
      margin-top: 12px;
      font-size: 15px;
    }
  }
</style>
