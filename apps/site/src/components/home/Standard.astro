---
/**
 * The Vaanika Standard: the four checks (mockup). Card 04 uses the exact §7 wording.
 *
 * Beside the checks, the lotus: always there, as a still from the first moment (a transparent
 * render of the 3D mark), with the 3D taking over only once it has drawn a checked first frame
 * (three/engine.ts). Each card has its part of the mark: 01 Saraswati (ivory), 02 Lakshmi (gold),
 * 03 Kali (shyama blue), 04 the chandra. With motion on, the card nearest the middle of the window
 * and its part glow softly (motion/chapters/standard.ts); under reduced motion nothing glows.
 *
 * Phones: heading, lotus, then the four cards (nothing pinned). Wider screens: the heading and the
 * lotus on the left (sticky), the cards on the right.
 */
import type { ImageMetadata } from 'astro';
import { CHECKS } from '../../data/facts';
import Stage from '../Stage.astro';
// the logo file itself: its paths draw the glow, so the glow has the mark's exact shapes
import markSvg from '../../assets/logo/vaanika-mark-colour-for-dark-bg.svg?raw';

const stills = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/3d/stills/standard.png', { eager: true }),
).map((m) => m.default);

// in the file's order: Saraswati, Kali, Lakshmi, the chandra, the base line
const d = [...markSvg.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1] ?? '');
/** The card order: 01 Saraswati, 02 Lakshmi, 03 Kali, 04 the chandra. */
const PARTS = [
  { key: 'saraswati', d: d[0] },
  { key: 'lakshmi', d: d[2] },
  { key: 'kali', d: d[1] },
  { key: 'chandra', d: d[3] },
];
---

<section id="standard" class="standard" aria-labelledby="standard-h" data-chapter="standard">
  <div class="container standard__inner">
    <div class="standard__side">
      <div class="standard__intro reveal">
        <p class="eyebrow">The Vaanika Standard</p>
        <h2 id="standard-h" class="h2 standard__title">
          We check the operator before we quote. Every time.
        </h2>
        <p class="lead standard__lead">
          Your quote names the operator and the aircraft, so you know exactly who is flying your
          family. If anything doesn’t check out, we don’t offer it — however good the price.
        </p>
        <a class="btn btn--outline standard__btn" href="#how">
          See a sample quote
        </a>
      </div>
      <div class="standard__lotus">
        <Stage
          name="mark"
          mode="checks"
          class="standard__stage"
          stills={stills}
          caption=""
          fit="contain"
          loading="eager"
          sizes="340px"
        />
        <svg class="standard__glow" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
          <defs>
            <filter id="standard-halo" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="11"></feGaussianBlur>
            </filter>
            <filter id="standard-inner" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="3"></feGaussianBlur>
            </filter>
          </defs>
          {PARTS.map((p) => (
            <g class:list={['standard__glow-part', `standard__glow-part--${p.key}`]}>
              <path d={p.d} class="standard__glow-halo" filter="url(#standard-halo)" />
              <path d={p.d} class="standard__glow-core" filter="url(#standard-inner)" />
            </g>
          ))}
        </svg>
      </div>
    </div>
    <div class="standard__cards">
    <p id="standard-checks-h" class="standard__label reveal">Four checks, every quote</p>
    <ol class="standard__checks" aria-labelledby="standard-checks-h">
      {CHECKS.map((c, i) => (
        <li class="standard__check reveal" data-check={i}>
          <p class="standard__num num display">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="standard__check-title">{c.title}</h3>
          <p class="standard__check-text">{c.text}</p>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<style>
  .standard {
    padding: 80px 0 72px;
  }

  /* wider screens: heading and lotus on the left, the four cards on the right */
  .standard__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 56px;
    align-items: start;
  }

  .standard__side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .standard__title {
    font-size: clamp(32px, 3.3vw, 48px);
    line-height: 1.08;
  }

  .standard__lead {
    margin-top: 18px;
    max-width: 520px;
  }

  .standard__btn {
    margin-top: 22px;
  }

  /* the lotus: the still (or the 3D) fills the box; the mark is 85% of its shorter side */
  .standard__lotus {
    --lotus-h: clamp(240px, 34vh, 340px);
    position: relative;
    height: var(--lotus-h);
    margin-top: 20px;
  }

  .standard__lotus :global(.standard__stage) {
    position: absolute;
    inset: 0;
  }

  /* The right column: a short gold label level with the heading's top, then the cards. The cards
     start 150 px down, beside the lotus: with card 01 in the middle of the window the whole lotus
     is still in view on the left (measured at 1024 to 1920 px wide). */
  .standard__cards {
    position: relative;
  }

  .standard__label {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .standard__label::before {
    content: '';
    width: 36px;
    height: 1px;
    background: linear-gradient(90deg, var(--gold-dark), var(--gold));
  }

  .standard__checks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 0;
    padding: 150px 0 0;
    list-style: none;
  }

  .standard__check {
    padding: 26px 28px;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: var(--panel);
    transition:
      border-color var(--dur-reveal) var(--ease-in-out),
      box-shadow var(--dur-reveal) var(--ease-in-out),
      opacity 0.7s ease,
      transform 0.7s var(--ease-out);
  }

  .standard__num {
    font-size: 34px;
    color: var(--gold);
    line-height: 1;
  }

  .standard__check-title {
    margin-top: 14px;
    font-size: 18px;
    font-weight: 700;
  }

  .standard__check-text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- The link between each card and its part of the lotus (motion on only) ---------- */

  .standard__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: min(85%, calc(var(--lotus-h) * 0.85));
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    overflow: visible;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .standard__glow-part {
    opacity: 0;
    transition: opacity var(--dur-reveal) var(--ease-in-out);
  }

  /* a wide soft halo (the shape thickened, then blurred) and a faint inner light */
  .standard__glow-halo {
    stroke-width: 9;
    stroke-linejoin: round;
    opacity: 0.6;
  }

  .standard__glow-core {
    opacity: 0.32;
  }

  .standard__glow-part--saraswati {
    fill: #f3ede2;
    stroke: #f3ede2;
  }

  .standard__glow-part--lakshmi {
    fill: #f0d89a;
    stroke: #f0d89a;
  }

  .standard__glow-part--kali {
    fill: #4a6fd6;
    stroke: #4a6fd6;
  }

  .standard__glow-part--chandra {
    fill: #f4e3b5;
    stroke: #f4e3b5;
  }

  /* the crescent is thin: a wider halo so its light reads like the petals' */
  .standard__glow-part--chandra .standard__glow-halo {
    stroke-width: 16;
  }

  :global(.motion-ready) .standard[data-active='0'] .standard__glow-part--saraswati,
  :global(.motion-ready) .standard[data-active='1'] .standard__glow-part--lakshmi,
  :global(.motion-ready) .standard[data-active='2'] .standard__glow-part--kali,
  :global(.motion-ready) .standard[data-active='3'] .standard__glow-part--chandra {
    opacity: 1;
  }

  :global(.motion-ready) .standard .standard__check.is-active {
    border-color: rgba(217, 188, 120, 0.75);
    box-shadow:
      0 0 0 1px rgba(217, 188, 120, 0.22),
      0 0 34px rgba(217, 188, 120, 0.14);
  }

  /* ---------- Phones: heading, lotus, the four cards; nothing pinned ---------- */

  @media (max-width: 767px) {
    .standard {
      padding: 56px 0;
    }

    .standard__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .standard__side {
      position: static;
    }

    .standard__title {
      font-size: clamp(30px, 8.2vw, 36px);
    }

    .standard__lead {
      margin-top: 14px;
      font-size: 16px;
    }

    .standard__btn {
      margin-top: 18px;
    }

    .standard__lotus {
      --lotus-h: 320px;
      margin: 12px 0 4px;
    }

    .standard__checks {
      gap: 16px;
      padding-top: 0;
    }

    /* phones: the cards follow the lotus; the label stays for screen readers */
    .standard__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .standard__check {
      padding: 20px 22px;
    }

    .standard__num {
      font-size: 30px;
    }

    .standard__check-title {
      margin-top: 10px;
    }
  }
</style>
