---
/** The Vaanika Standard: the four checks (mockup). Card 04 uses the exact §7 wording. */
import type { ImageMetadata } from 'astro';
import { CHECKS } from '../../data/facts';
import Stage from '../Stage.astro';

const stills = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/3d/stills/standard.jpg', { eager: true }),
).map((m) => m.default);
---

<section id="standard" class="standard" aria-labelledby="standard-h" data-chapter="standard">
  <div class="container standard__inner">
    <div class="standard__side">
    <div class="standard__intro reveal">
      <p class="eyebrow">The Vaanika Standard</p>
      <h2 id="standard-h" class="h2 standard__title">
        We check the operator before we quote. Every time.
      </h2>
      <p class="lead standard__lead">
        Your quote names the operator and the aircraft, so you know exactly who is flying your
        family. If anything doesn’t check out, we don’t offer it — however good the price.
      </p>
      <a class="btn btn--outline standard__btn" href="#how">
        See a sample quote
      </a>
    </div>
    <!-- With motion: the mark's petals and crescent, one lit per check (three/scenes/mark.ts) -->
    <Stage name="mark" mode="checks" class="standard__stage" stills={stills} caption="" sizes="(max-width: 767px) 100vw, 40vw" />
    </div>
    <ol class="standard__checks">
      {CHECKS.map((c, i) => (
        <li class="standard__check reveal" data-check={i}>
          <p class="standard__num num display">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="standard__check-title">{c.title}</h3>
          <p class="standard__check-text">{c.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .standard {
    padding: 130px 0 120px;
  }

  .standard__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
  }

  .standard__side {
    flex: 1 1 440px;
    min-width: 0;
  }

  .standard__title {
    font-size: clamp(36px, 4.4vw, 62px);
    line-height: 1.06;
  }

  .standard__lead {
    margin-top: 22px;
    max-width: 520px;
  }

  .standard__btn {
    margin-top: 30px;
  }

  .standard__checks {
    flex: 1 1 520px;
    min-width: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .standard__check {
    padding: 28px;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .standard__num {
    font-size: 34px;
    color: var(--gold);
    line-height: 1;
  }

  .standard__check-title {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 700;
  }

  .standard__check-text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .standard {
      padding: 80px 0;
    }

    .standard__inner {
      gap: 40px;
    }

    .standard__side,
    .standard__checks {
      flex-basis: 100%;
    }
  }

  @media (max-width: 559px) {
    .standard__checks {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .standard__check {
      padding: 22px;
    }
  }
  /* ---------- With motion: the mark beside the checks (motion/chapters/standard.ts) ---------- */

  /* without motion: the rendered still of the mark, under the intro */
  .standard__side :global(.standard__stage) {
    height: 300px;
    margin-top: 28px;
  }

  /* desktop: the intro scrolls away; the mark sticks beside the checks */
  :global(.motion-ready) .standard__side {
    align-self: stretch;
  }

  :global(.motion-ready) .standard__side :global(.standard__stage) {
    display: block;
    position: sticky;
    top: calc(var(--header-h) + 6vh);
    height: min(60vh, 520px);
    margin-top: 24px;
  }

  :global(.motion-ready) .standard__checks {
    grid-template-columns: minmax(0, 1fr);
    gap: 22vh;
    padding: 10vh 0 22vh;
  }

  :global(.motion-ready) .standard .standard__check {
    transition:
      border-color var(--dur-panel) ease,
      background-color var(--dur-panel) ease,
      opacity var(--dur-panel) ease;
  }

  /* the other checks rest a little quieter (still above 4.5:1 for every line of text) */
  :global(.motion-ready) .standard .standard__check.is-in:not(.is-active) {
    opacity: 0.8;
  }

  :global(.motion-ready) .standard .standard__check.is-active {
    border-color: var(--gold-dark);
    background: linear-gradient(180deg, #151b38, var(--panel));
  }

  @media (max-width: 767px) {
    :global(.motion-ready) .standard__inner {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
    }

    /* phones: the mark sticks under the header and the checks scroll over it */
    :global(.motion-ready) .standard__side {
      display: contents;
    }

    :global(.motion-ready) .standard__side :global(.standard__stage) {
      position: sticky;
      top: var(--header-h);
      z-index: 0;
      align-self: stretch;
      height: 34svh;
      margin: 24px calc(var(--gutter) * -1) 0;
    }

    :global(.motion-ready) .standard__checks {
      position: relative;
      z-index: 1;
      gap: 30svh;
      padding: 6svh 0 18svh;
    }
  }
</style>
